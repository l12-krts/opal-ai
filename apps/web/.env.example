# ─── Opal web — environment ────────────────────────────────────────────────
# Copy to .env.local (or run `npm run setup`, which fills in the random secrets).

# Public URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# Postgres (docker compose up -d db)
DATABASE_URL=postgres://opal:opal_dev_password@127.0.0.1:5433/opal

# ── Site lock: nobody gets past /unlock without this password ──
# Generate with: npm run gate:hash -- "your password"
OPAL_GATE_PASSWORD_HASH=
# Random 32+ byte secret used to sign the unlock cookie
OPAL_GATE_SECRET=

# ── Auth (Better Auth) ──
BETTER_AUTH_SECRET=
# Google OAuth client (console.cloud.google.com → Credentials → OAuth client ID → Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email + password sign-in for local testing only. Ignored when NODE_ENV=production.
OPAL_DEV_EMAIL_LOGIN=true
# Comma-separated emails that become admins on first sign-in
OPAL_ADMIN_EMAILS=

# ── Secrets vault: AES-256-GCM key, 32 bytes base64. Never rotate without re-encrypting. ──
OPAL_SECRETS_KEY=

# ── Models ──
# Format: provider:model-id   providers: nvidia | openai | anthropic | ollama | lmstudio
# OPAL_MODEL_MAIN can be opal:auto (Lightning, switching to Thinking for complex tasks or images),
# opal:lightning, opal:thinking, or any provider:model-id.
NVIDIA_API_KEY=
OPAL_MODEL_MAIN=opal:auto
OPAL_MODEL_LIGHTNING=nvidia:nvidia/nemotron-3-ultra-550b-a55b
OPAL_MODEL_THINKING=nvidia:mistralai/mistral-large-4-1t-a52b
OPAL_MODEL_FAST=nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ── Composio (connectors) ──
COMPOSIO_API_KEY=

# ── Web search: SearXNG (docker compose up -d search). "off" uses DuckDuckGo only. ──
SEARXNG_URL=http://127.0.0.1:8888

# ── Sandboxes (self-hosted Docker) ──
OPAL_SANDBOX_IMAGE=opal-sandbox:latest
OPAL_SANDBOX_NETWORK=opal-sandbox-net
# Leave empty to use the local Docker socket / named pipe
DOCKER_HOST=
