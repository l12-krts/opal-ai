{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opal",
  "version": "0.1.0",
  "identifier": "app.opal.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Opal",
    "category": "Productivity",
    "shortDescription": "Opal: chat, agents, study and handwriting",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["opal"]
      }
    }
  }
}
